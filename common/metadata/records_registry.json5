 *   @property {string} [records[].versions[].record_id="<concept_id>-<version>"] - Unique versioned record identifier used as the catalogue key.
 *   @property {string} [records[].versions[].rmd_path] - Path (relative to `child_repo_path`) to an executable `.Rmd` manuscript; enables WYSIWYG DOM compilation and `.Rmd` source staging.
 *   @property {string} [records[].versions[].status="Published"] - Lifecycle status label (e.g. `"Published"`, `"Archived"`).
 *   @property {string} [records[].versions[].subtitle=""] - Optional subtitle displayed beneath the title and included in MLA citations; overrides `.Rmd` frontmatter `subtitle`.
 *   @property {Object[]} [records[].versions[].supplementary_markdown=[]] - Validation or audit `.md` reports compiled to `/records/<concept_id>/<version>-<key>/` and staged for download.
 *    @property {string} records[].versions[].supplementary_markdown[].key - URL-safe report slug appended to `<version>-<key>` routes.
 *    @property {string} records[].versions[].supplementary_markdown[].path - Path (relative to `child_repo_path`) to the `.md` report file.
 *    @property {string} records[].versions[].supplementary_markdown[].title - Display title for the supplementary report page and download link.
 *   @property {string} [records[].versions[].title] - Version title; overrides `.Rmd` frontmatter `title` and falls back to `project_name` or `concept_id`.
 *   @property {string} records[].versions[].version - Version identifier (e.g. `"1.0"`, `"0.4"`), mounted at `/records/<concept_id>/<version>/`.
 */
{
  records: [
