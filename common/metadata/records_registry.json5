/**
 * Intellte Working Papers & Artefacts Registry (`common/metadata/records_registry.json5`).
 * Lite InvenioRDM-inspired record, versioning and tagging catalogue consumed by `A_discover_records.js`.
 *
 * @typedef {Object} IntellteRecordsRegistry
 * @property {Object[]} records - Ordered list of working paper concept records indexed by the portal.
 *  @property {string} records[].child_repo_path - Workspace-relative path to the child repository root (e.g. `"papers/velkscala"`), against which version file paths resolve.
 *  @property {string} records[].concept_id - URL-safe concept slug used for routes (`/records/<concept_id>/`) and staged artefact paths (`/artefacts/<concept_id>/<version>/`).
 *  @property {string} records[].latest_version - Version string matching the canonical release in `versions[]`, mounted at `/records/<concept_id>/` and badged `"Latest"`.
 *  @property {string} records[].project_id - Four-digit CRD project identifier (e.g. `"0717"`), displayed on working paper headers, cards and MLA citations.
 *  @property {string} records[].project_name - Human-readable project name (e.g. `"Velkscala"`), used in breadcrumbs and fallback titles.
 *  @property {string} [records[].record_type="Working Paper"] - Record classification badge shown on catalogue cards and metadata sidebars.
 *  @property {string[]} [records[].tags=[]] - Lowercase kebab-case topic tags used for facet filtering and search indexing.
 *  @property {Object[]} records[].versions - Ordered list of version releases belonging to this concept record.
 *   @property {string} [records[].versions[].abstract_excerpt=""] - Optional plain-text abstract shown on search cards and above PDF-only views; automatically overwritten from `# Abstract` when `rmd_path` is compiled.
 *   @property {string} [records[].versions[].authors_line="Confoederatio, Research Division"] - Formatted author byline; overrides `.Rmd` frontmatter `authors_line`.
 *   @property {string} [records[].versions[].bib_path] - Path (relative to `child_repo_path`) to a BibTeX `.bib` file for numerical MLA citation resolution and artefact staging.
 *   @property {string} [records[].versions[].csl_path] - Path (relative to `child_repo_path`) to a Citation Style Language `.csl` file associated with the manuscript.
 *   @property {Object[]} [records[].versions[].figures=[]] - High-DPI `.png` figures staged into `/artefacts/<concept_id>/<version>/` and listed in the downloads sidebar.
 *    @property {string} records[].versions[].figures[].key - Identifier key for the figure asset.
 *    @property {string} records[].versions[].figures[].path - Path (relative to `child_repo_path`) to the `.png` figure file.
 *    @property {string} records[].versions[].figures[].title - Display title for the figure in the artefacts sidebar.
 *   @property {string} [records[].versions[].hero_figure] - Path (relative to `child_repo_path`) to the primary hero `.png` figure; overrides `.Rmd` frontmatter `hero_figure`.
 *   @property {string} [records[].versions[].pdf_path] - Path (relative to `child_repo_path`) to the compiled `.pdf` manuscript, staged for download and embedded PDF viewing.
 *   @property {string} [records[].versions[].published_date] - Human-readable publication date in EN-GB format (e.g. `"28 October 2026"`); falls back to `.Rmd` frontmatter `date`.
 *   @property {string} [records[].versions[].published_iso_gmt="2026-10-28T00:00:00Z"] - ISO-8601 GMT+0 timestamp (`YYYY-MM-DDTHH:mm:ssZ`) used for chronological sorting in the catalogue.
 *   @property {string} [records[].versions[].record_id="<concept_id>-<version>"] - Unique versioned record identifier used as the catalogue key.
 *   @property {string} [records[].versions[].rmd_path] - Path (relative to `child_repo_path`) to an executable `.Rmd` manuscript; enables WYSIWYG DOM compilation and `.Rmd` source staging.
 *   @property {string} [records[].versions[].status="Published"] - Lifecycle status label (e.g. `"Published"`, `"Archived"`).
 *   @property {string} [records[].versions[].subtitle=""] - Optional subtitle displayed beneath the title and included in MLA citations; overrides `.Rmd` frontmatter `subtitle`.
 *   @property {Object[]} [records[].versions[].supplementary_markdown=[]] - Validation or audit `.md` reports compiled to `/records/<concept_id>/<version>-<key>/` and staged for download.
 *    @property {string} records[].versions[].supplementary_markdown[].key - URL-safe report slug appended to `<version>-<key>` routes.
 *    @property {string} records[].versions[].supplementary_markdown[].path - Path (relative to `child_repo_path`) to the `.md` report file.
 *    @property {string} records[].versions[].supplementary_markdown[].title - Display title for the supplementary report page and download link.
 *   @property {string} [records[].versions[].title] - Version title; overrides `.Rmd` frontmatter `title` and falls back to `project_name` or `concept_id`.
 *   @property {string} records[].versions[].version - Version identifier (e.g. `"1.0"`, `"0.4"`), mounted at `/records/<concept_id>/<version>/`.
 */
/**
