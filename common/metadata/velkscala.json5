/*
  Intellte Project Metadata Configuration (common/metadata/<subfolder>/<project_key>.json5)
  All .json5 files in common/metadata/ (including nested subfolders) merge into a single dictionary consumed by A_discover_records.js.

  Semantic Structure:
  {
    <concept_id>: { //URL-safe slug mounted at /records/<concept_id>/ and /artefacts/<concept_id>/<version>/.
      child_repo_path: "papers/<concept_id>", //Optional. Workspace-relative child repository root; defaults to papers/<concept_id>.
      project_name: "<Project Name>", //Display name used in breadcrumbs and fallback titles.
      record_type: "Working Paper", //Optional. Classification badge shown on catalogue cards and sidebars.
      tags: ["<tag-key>"], //Optional. Lowercase kebab-case topic tags for facet filtering and search.
      versions: [ //Latest release is resolved automatically from the versions array.
        {
          abstract_excerpt: "<Plain-text abstract>", //Optional. Automatically extracted from # Abstract when rmd_path is compiled.
          authors: [ //Optional. Per-author affiliations; division acronyms ("CRD", "CTD") resolve via common/defines/intellte_defines.json5.
            {
              division: "CRD",
              name: "<Author Name>"
            }
          ],
          authors_line: "<Author(s)>", //Optional. Auto-derived from authors when omitted; overrides .Rmd frontmatter authors_line.
          bib_path: "<path/to/references.bib>", //Optional. Relative to child_repo_path; compiled target .bib used for citations and staging.
          csl_path: "<path/to/style.csl>", //Optional. Relative to child_repo_path; CSL style file associated with the manuscript.
          figures: [ //Optional. High-DPI .png figures staged into /artefacts/<concept_id>/<version>/.
            {
              key: "<figure_key>",
              path: "<path/to/figure.png>",
              title: "<Display Title>"
            }
          ],
          hero_figure: "<path/to/hero.png>", //Optional. Relative to child_repo_path; overrides .Rmd frontmatter hero_figure.
          pdf_path: "<path/to/manuscript.pdf>", //Optional. Relative to child_repo_path; staged for download and embedded PDF viewing.
          published_date: "28 October 2026", //Optional. EN-GB date (GMT+0); parsed for chronological sorting and falls back to .Rmd date.
          record_id: "<concept_id>-<version>", //Optional. Unique catalogue key; defaults to <concept_id>-<version>.
          rmd_path: "<path/to/main.Rmd>", //Optional. Relative to child_repo_path; enables WYSIWYG DOM compilation and .Rmd staging.
          sources_path: "<path/to/sources.json5>", //Optional. Relative to child_repo_path; JSON5 DOI/URL array compiled into bib_path.
          status: "Published", //Optional. Lifecycle status label (e.g. "Published", "Archived").
          subtitle: "<Subtitle>", //Optional. Shown beneath title and in MLA citations; overrides .Rmd frontmatter subtitle.
          supplementary_markdown: [ //Optional. Validation/audit .md reports compiled to /records/<concept_id>/<version>-<key>/.
            {
              key: "<report_key>",
              path: "<path/to/report.md>",
              title: "<Display Title>"
            }
          ],
          title: "<Title>", //Optional. Overrides .Rmd frontmatter title; falls back to project_name or <concept_id>.
          version: "1.0" //Version identifier mounted at /records/<concept_id>/<version>/.
        }
      ]
    }
  }
*/
{
  velkscala: {
    child_repo_path: "papers/velkscala",
    project_name: "Velkscala",
    record_type: "Working Paper",
    tags: [
      "anthropology",
      "cartography",
      "demography",
      "statistics"
    ],
