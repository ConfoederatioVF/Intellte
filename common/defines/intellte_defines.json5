{
  // ===========================================================================
  // Intellte Repository & Portal Defines (common/defines/intellte_defines.json5)
  // Single source of truth for CRD Working Papers repository paths, child
  // repositories, R/Node build pipelines, and VitePress static site output.
  // ===========================================================================
  project_name: "Intellte",
  organisation: "Confoederatio, Research Division (CRD)",
  timezone: "GMT+0",
  default_locale: "en-gb",
  supported_locales: ["en-gb", "fr", "de"],
  rscript_path: "C:/Program Files/R/R-4.6.1/bin/Rscript.exe",

  directories: {
    common_defines: "common/defines",
    common_metadata: "common/metadata",
    docs: "docs",
    docs_artefacts: "docs/public/artefacts",
    docs_cache: "docs/.vitepress/cache/rmd_dom",
    docs_data: "docs/data",
    docs_fonts: "docs/public/fonts",
    docs_public: "docs/public",
    docs_records: "docs/records",
    localisation: "localisation",
    node_framework: "core/framework/node",
    papers: "papers",
    r_framework: "core/framework/R",
    rticles_intellte: "core/rticles/intellte",
    rticles_intellte_resources: "core/rticles/intellte/resources",
    rticles_intellte_skeleton: "core/rticles/intellte/skeleton",
    uf: "UF",
    ui_components: "core/ui/components",
    ui_portal: "core/ui/intellte_portal"
  },

  child_repositories: [
    {
      id: "eoscala",
      name: "eoscala",
      path: "papers/eoscala"
    },
    {
      id: "stadester",
      name: "stadester",
      path: "papers/stadester"
    },
    {
      id: "velkscala",
      name: "velkscala",
      path: "papers/velkscala",
      defines_path: "papers/velkscala/common/defines/filepath_defines.json5"
    }
  ]
}

