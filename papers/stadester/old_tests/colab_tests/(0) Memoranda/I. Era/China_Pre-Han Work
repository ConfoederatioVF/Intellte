mbers\n","# Use Otsu's thresholding as it often works well for separating text from background.\n","_, thresh_cropped_yaxis = cv2.threshold(gray_cropped_yaxis, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n","\n","# Use OCR (pytesseract) on the thresholded cropped image to extract text and data,\n","# including bounding boxes to get vertical positions.\n","# Use psm 6 for assuming a single uniform block of text, or psm 11 for sparse text.\n","# Let's try psm 6 first.\n","custom_config_yaxis = r'--oem 3 --psm 6'\n","ocr_output_yaxis = pytesseract.image_to_data(thresh_cropped_yaxis, output_type=pytesseract.Output.DICT, config=custom_config_yaxis)\n","\n","# Extract text, confidence, and bounding box for each detected item\n","extracted_yaxis_data = []\n","n_boxes_yaxis = len(ocr_output_yaxis['level'])\n","for i in range(n_boxes_yaxis):\n","    text = ocr_output_yaxis['text'][i].strip()\n","    conf = int(ocr_output_yaxis['conf'][i])\n","    # Filter out empty strings or low confidence results\n","    if text and conf > 70: # Increased confidence threshold for numbers\n","        x = ocr_output_yaxis['left'][i]\n","        y = ocr_output_yaxis['top'][i]\n","        w = ocr_output_yaxis['width'][i]\n","        h = ocr_output_yaxis['height'][i]\n","        extracted_yaxis_data.append({'text': text, 'box': (x, y, w, h), 'confidence': conf})\n","\n","# Filter the extracted data to keep only numerical values that could be y-axis ticks.\n","# Numbers on the y-axis are expected to be integers and relatively large (e.g., 50, 100, 150).\n","yaxis_numerical_labels = []\n","for item in extracted_yaxis_data:\n","    # Try to convert the text to a number\n","    try:\n","        value = float(item['text']) # Use float to handle potential decimals if any, though integers are expected\n","        # Add a check to see if the number seems reasonable for a y-axis label in this context\n","        # Based on the image, values are in ranges like 0, 50, 100, 150. Let's assume values > 1.\n","        if value >= 0: # Assuming hectare values are non-negative\n","             # Store the value and its vertical position (center of the bounding box)\n","            yaxis_numerical_labels.append({'value': value, 'y_pos': item['box'][1] + item['box'][3] // 2})\n","    except ValueError:\n","        # Not a valid number, ignore\n","        pass\n","\n","# Sort the numerical labels by their vertical position (y_pos), from top to bottom\n","yaxis_numerical_labels.sort(key=lambda item: item['y_pos'])\n","\n","print(\"\\n--- Extracted Y-axis Numerical Labels and Vertical Positions ---\")\n","for label_info in yaxis_numerical_labels:\n","    print(f\"Value: {label_info['value']}, Y-position (pixel): {label_info['y_pos']}\")\n","\n","# --- Determine the relationship between pixel height and hectare value ---\n","# This assumes a linear relationship, which is typical for a bar chart y-axis.\n","# We need at least two points (value, y_pos) to define the relationship.\n","# Ideally, we would use the origin (0, max_y_pixel) if detected.\n","# Let's use the top-most and bottom-most detected numerical labels assuming they represent\n","# a range on the y-axis. The bottom-most label is likely near the x-axis (0 hectares).\n","\n","if len(yaxis_numerical_labels) >= 2:\n","    # Use the lowest and highest detected y-axis values and their positions\n","    # The lowest y_pos corresponds to the highest hectare value on the chart (top of y-axis)\n","    # The highest y_pos corresponds to the lowest hectare value on the chart (bottom of y-axis, likely 0)\n","\n","    # Find the point closest to the bottom of the image (likely the origin or a low value)\n","    # The y-axis pixel coordinates increase downwards.\n","    bottom_point = max(yaxis_numerical_labels, key=lambda item: item['y_pos'])\n","    top_point = min(yaxis_numerical_labels, key=lambda item: item['y_pos'])\n","\n","    print(f\"\\nUsing points: Bottom ({bottom_point['value']} ha, {bottom_point['y_pos']} px), Top ({top_point['value']} ha, {top_point['y_pos']} px)\")\n","\n","    # Calculate the pixel difference and hectare difference\n","    pixel_range = bottom_point['y_pos'] - top_point['y_pos']\n","    hectare_range = bottom_point['value'] - top_point['value']\n","\n","    # Avoid division by zero if the detected points have the same y-position or same hectare value\n","    if pixel_range > 0 and hectare_range != 0:\n","        # Calculate the scale factor: hectares per pixel\n","        hectares_per_pixel = hectare_range / pixel_range\n","        print(f\"Calculated hectares per pixel: {hectares_per_pixel}\")\n","\n","        # We also need the hectare value at a reference pixel position (e.g., the y-position of the origin, assumed to be at the bottom point's y_pos)\n","        # The hectare value at any pixel y can be calculated as:\n","        # hectare =  hectare_at_bottom_point + (y_at_bottom_point - y) * hectares_per_pixel\n","        # Let's store hectares_per_pixel and the reference point (bottom_point).\n","        pixel_to_hectare_calibration = {\n","            'hectares_per_pixel': hectares_per_pixel,\n","            'reference_y_pixel': bottom_point['y_pos'],\n","            'reference_hectare_value': bottom_point['value']\n","        }\n","        print(\"\\nPixel to Hectare Calibration Factor/Model:\")\n","        print(pixel_to_hectare_calibration)\n","\n","    else:\n","        print(\"\\nCould not determine a valid pixel-to-hectare relationship from the extracted y-axis labels.\")\n","        pixel_to_hectare_calibration = None # Indicate failure\n","\n","else:\n","    print(\"\\nNot enough numerical labels detected on the y-axis to determine the pixel-to-hectare relationship.\")\n","    pixel_to_hectare_calibration = None # Indicate failure\n","\n","# Store the calibration factor\n","pixel_to_hectare_factor = pixel_to_hectare_calibration"],"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--- Extracted Y-axis Numerica