spacing=0.02 # Added horizontal spacing for better layout\n","                   )\n","\n","# Add traces for each region and source\n","trace_index = 0\n","for i, region in enumerate(regions):\n","    row = i // n_cols + 1\n","    col = i % n_cols + 1\n","\n","    all_lats = []\n","    all_lons = []\n","\n","    for source in df_filtered['source'].unique():\n","        df_region_source = df_filtered[(df_filtered['region'] == region) & (df_filtered['source'] == source)].dropna(subset=['latitude', 'longitude']) # Drop rows with None lat/lon\n","\n","        if not df_region_source.empty:\n","            all_lats.extend(df_region_source['latitude'].tolist())\n","            all_lons.extend(df_region_source['longitude'].tolist())\n","\n","            fig.add_trace(\n","                go.Scattergeo(\n","                    lon = df_region_source['longitude'],\n","                    lat = df_region_source['latitude'],\n","                    mode = 'lines+markers',\n","                    name = f'{region.replace(\"_\", \" \").title()} ({source.title()})',\n","                    text = df_region_source['year'],\n","                    marker = dict(\n","                        size = 5,\n","                        opacity = 0.8,\n","                        color = colors[trace_index % len(colors)] # Assign distinct color\n","                    ),\n","                    line = dict(\n","                        width = 1,\n","                        color = colors[trace_index % len(colors)] # Assign distinct color\n","                    )\n","                ),\n","                row=row, col=col\n","            )\n","            trace_index += 1 # Increment trace index for next color\n","\n","\n","    # Calculate bounding box and center for the current subplot\n","    if all_lats and all_lons:\n","        min_lat, max_lat = min(all_lats), max(all_lats)\n","        min_lon, max_lon = min(all_lons), max(all_lons)\n","\n","        # Add a margin (approx. 200km in degrees - rough estimation)\n","        margin_deg = 200 / 111.0\n","\n","        min_lat = max(min_lat - margin_deg, -90)\n","        max_lat = min(max_lat + margin_deg, 90)\n","        min_lon = max(min_lon - margin_deg, -180)\n","        max_lon = min(max_lon + margin_deg, 180)\n","\n","        center_lat = (min_lat + max_lat) / 2\n","        center_lon = (min_lon + max_lon) / 2\n","\n","        # Calculate a scale factor based on the bounding box size\n","        # This is a rough estimation and might need adjustment\n","        # A smaller range means more zoom, so scale should be larger\n","        lat_range = max_lat - min_lat\n","        lon_range = max_lon - min_lon\n","        # Avoid division by zero for cases with a single point or very small range\n","        scale_lat = 180 / lat_range if lat_range > 0 else 1\n","        scale_lon = 360 / lon_range if lon_range > 0 else 1\n","        scale = min(scale_lat, scale_lon) * 0.8 # Use a factor to avoid over-zooming\n","\n","        # Get subplot-specific geo axis name\n","        geo_axis_name = f'geo{i+1}' if i > 0 else 'geo'\n","\n","        fig.update_layout({\n","            geo_axis_name: dict(\n","                scope='world', # Keep scope as world\n","                projection_type='equirectangular', # Use equirectangular projection\n","                projection_scale=scale, # Control zoom level\n","                center=dict(lat=center_lat, lon=center_lon),\n","                showcoastlines=True, coastlinecolor=\"RebeccaPurple\",\n","                showland=True, landcolor=\"LightGrey\",\n","                showocean=True, oceancolor=\"LightBlue\",\n","                showlakes=True, lakecolor=\"Blue\",\n","                showrivers=True, rivercolor=\"Blue\",\n","            )\n","        })\n","\n","        # Add a distance scale to each subplot using domain coordinates\n","        # Get the domain of the current subplot\n","        geo_domain = fig.layout[geo_axis_name]['domain']\n","        x_domain_start = geo_domain['x'][0]\n","        y_domain_start = geo_domain['y'][0]\n","\n","        # Position the scale bar line using 'paper' xref and yref relative to the domain start\n","        scale_bar_x0 = x_domain_start + (geo_domain['x'][1] - x_domain_start) * 0.05\n","        scale_bar_x1 = scale_bar_x0 + (geo_domain['x'][1] - x_domain_start) * 0.1 # Adjust length as needed (e.g., 10% of subplot width)\n","        scale_bar_y = y_domain_start + (geo_domain['y'][1] - y_domain_start) * 0.05\n","\n","\n","        fig.add_shape(\n","            type=\"line\",\n","            xref=\"paper\", yref=\"paper\",\n","            x0=scale_bar_x0, y0=scale_bar_y, x1=scale_bar_x1, y1=scale_bar_y,\n","            line=dict(color=\"Black\", width=2)\n","        )\n","\n","        # Add the text label for the scale bar\n","        fig.add_annotation(\n","            go.layout.Annotation(\n","                text=f'{scale_length_km} km',\n","                xref=\"paper\", yref=\"paper\",\n","                x=scale_bar_x0 + (scale_bar_x1 - scale_bar_x0) / 2, # Position text in the middle of the scale bar\n","                y=scale_bar_y + (geo_domain['y'][1] - y_domain_start) * 0.02, # Position text slightly above the scale bar\n","                showarrow=False,\n","                font=dict(size=10, color=\"black\"),\n","                xanchor='center', # Center the text horizontally\n","                yanchor='bottom' # Position the text below the y coordinate\n","            )\n","        )\n","\n","\n","    else:\n","        geo_axis_name = f'geo{i+1}' if i > 0 else 'geo'\n","        fig.update_layout({\n","            geo_axis_name: dict(\n","                scope='world', # Keep scope as world\n","                projection_type='equirectangular', # Use equirectangular projection\n","                showcoastlines=True, coastlinecolor=\"RebeccaPurple\",\n","                showland=True, landcolor=\"LightGrey\",\n","                showocean=True, oceancolor=\"Lig