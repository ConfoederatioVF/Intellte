ce":["import json\n","import plotly.graph_objects as go\n","import os\n","from google.colab import drive\n","import pandas as pd\n","from plotly.subplots import make_subplots\n","import random  # <-- 1. IMPORT RANDOM\n","\n","# Mount Google Drive\n","drive.mount('/content/drive')\n","resolution = 4\n","has_labels = True\n","\n","# Find the JSON file using os.walk\n","json_file_path = None\n","for root, dirs, files in os.walk('/content/drive/My Drive'):\n","    if 'stadester_top_120.json' in files:\n","        json_file_path = os.path.join(root, 'stadester_top_120.json')\n","        break\n","\n","if json_file_path is None:\n","    print(\"Error: stadester_top_120.json not found.\")\n","else:\n","    # Load the JSON data\n","    with open(json_file_path, 'r') as f:\n","        data = json.load(f)\n","\n","    # Prepare data for plotting\n","    plot_data = []\n","    for variable in ['area', 'density', 'density_ghsl', 'population']:\n","        if variable in data:\n","            for city_data in data[variable].values():\n","                city_data['variable_name'] = variable\n","                city_data['variable_value'] = city_data[variable]\n","                city_data['name'] = city_data['name'][:12]\n","                if 'colour' in city_data:\n","                    city_data['color_hex'] = f'#{city_data[\"colour\"][0]:02x}{city_data[\"colour\"][1]:02x}{city_data[\"colour\"][2]:02x}'\n","                else:\n","                    city_data['color_hex'] = '#808080'\n","                if 'region' in city_data:\n","                    city_data['region'] = city_data['region']\n","                else:\n","                    city_data['region'] = 'Unknown Region'\n","                plot_data.append(city_data)\n","        else:\n","            print(f\"Warning: Variable '{variable}' not found in the JSON data.\")\n","\n","    df = pd.DataFrame(plot_data)\n","    df['latitude'] = df['coords'].apply(lambda x: x[0] if isinstance(x, list) and len(x) > 0 else None)\n","    df['longitude'] = df['coords'].apply(lambda x: x[1] if isinstance(x, list) and len(x) > 1 else None)\n","    df.dropna(subset=['latitude', 'longitude'], inplace=True)\n","\n","    def scale_size(val, vmin, vmax, min_size=10*resolution, max_size=50*resolution):\n","        if vmax == vmin:\n","            return (min_size + max_size) / 2\n","        return min_size + (max_size - min_size) * (val - vmin) / (vmax - vmin)\n","\n","    # UNCHANGED: Using the original go.Figure with make_subplots\n","    fig = make_subplots(\n","        rows=2, cols=4,\n","        subplot_titles=[\n","            \"City Area Map\", \"City Centre Density Map (<1975, Stadestér)\", \"City Centre Density Map (>=1975, GHSL)\", \"City Population Map\",\n","            \"City Area by Rank\", \"City Centre Density by Rank (<1975, Stadestér)\", \"City Centre Density by Rank (>=1975, GHSL)\", \"City Population by Rank\"\n","        ],\n","        specs=[\n","            [{\"type\": \"geo\"}, {\"type\": \"geo\"}, {\"type\": \"geo\"}, {\"type\": \"geo\"}],\n","            [{\"type\": \"xy\"}, {\"type\": \"xy\"}, {\"type\": \"xy\"}, {\"type\": \"xy\"}]\n","        ],\n","        vertical_spacing=0,\n","        horizontal_spacing=0.035/resolution\n","    )\n","\n","    variables = ['area', 'density', 'density_ghsl', 'population']\n","    # <-- 2. DEFINE THE LIST OF POSSIBLE POSITIONS\n","    positions = [\n","        'top left', 'top center', 'top right',\n","        'middle left', 'middle right',\n","        'bottom left', 'bottom center', 'bottom right'\n","    ]\n","\n","    for j, variable in enumerate(variables):\n","        df_variable = df[df['variable_name'] == variable].copy()\n","        if df_variable.empty:\n","            print(f\"No data to plot for variable: {variable}\")\n","            continue\n","\n","        df_variable = df_variable.sort_values(by='variable_value', ascending=False).reset_index(drop=True)\n","        df_variable['rank'] = df_variable.index + 1\n","        df_variable['label'] = (\n","            df_variable['rank'].astype(str) + '. ' +\n","            df_variable['name']\n","        )\n","        df_variable['text_label'] = ''\n","        if has_labels:\n","          df_variable.loc[df_variable['rank'] <= 10, 'text_label'] = df_variable['label']\n","\n","        vmin = df_variable['variable_value'].min()\n","        vmax = df_variable['variable_value'].max()\n","        df_variable['marker_size'] = df_variable['variable_value'].apply(lambda v: scale_size(v, vmin, vmax))\n","\n","        # Map: one trace per region for legend\n","        for region, region_df in df_variable.groupby('region'):\n","            fig.add_trace(\n","                go.Scattergeo(\n","                    lon=region_df['longitude'],\n","                    lat=region_df['latitude'],\n","                    text=region_df['label'],\n","                    marker=dict(\n","                        size=region_df['marker_size'],\n","                        color=region_df['color_hex'].iloc[0],\n","                        line=dict(width=1, color='black'),\n","                        sizemode='diameter',\n","                        opacity=0.8\n","                    ),\n","                    hovertemplate=(\n","                        \"<b>%{text}</b><br>\" +\n","                        variable.capitalize() + \": %{marker.size:.2f}<br>\" +\n","                        \"Lat: %{lat:.2f}<br>Lon: %{lon:.2f}<extra></extra>\"\n","                    ),\n","                    name=region,\n","                    showlegend=(j == 0),\n","                    mode='markers'\n","                ),\n","                row=1, col=j+1\n","            )\n","\n","        # Add top 10 labels (drawn on top) with ASCII black background and white text\n","        top10 = df_variable[df_variable['rank'] <= 10].copy()\n","        top10['block'] = top10['text_label'].apply(lambda x: '█' * len(x))\n","\n","        # <-- 3. CREATE A LIST OF RANDOM POSITIONS FOR THE TOP 10 LABELS\n","        random_positions = [random.choice(positions) for _ in range(len(top10))]\n","\n","        # 1. Black block background\n","        fig.add_trace(\n","            go.Scattergeo(\n","                lon=top10['longitude'],\n","                lat=top10['latitude'],\n","                text=top10['block'],\n","                textfont=dict(\n","                    color='rgba(0, 0, 0, 0.5)',\n","                    family='DejaVu Sans Mono, monospace'\n","                ),\n","                mode='text',\n","                # <-- 4. APPLY THE RANDOM POSITIONS\n","                textposition=random_positions,\n","                showlegend=False,\n","                hoverinfo='skip'\n","            ),\n","            row=1, col=j+1\n","        )\n","\n","        # 2. White label on top\n","        fig.add_trace(\n","            go.Scattergeo(\n","                lon=top10['longitude'],\n","                lat=top10['latitude'],\n","                text=top10['text_label'],\n","                textfont=dict(\n","                    color=\"rgba(255,255,255,0.7)\",\n","                    family='DejaVu Sans Mono, monospace'\n","                ),\n","                mode='text',\n","                # <-- 5. APPLY THE SAME RANDOM POSITIONS TO ALIGN\n","                textposition=random_positions,\n","                showlegend=False,\n","                hoverinfo='skip'\n","            ),\n","            row=1, col=j+1\n","        )\n","\n","        # Bar chart: rank vs value\n","        fig.add_trace(\n","            go.Bar(\n","                x=df_variable['rank'],\n","                y=df_variable['variable_value'],\n","                text=df_variable['name'],\n","                marker=dict(\n","                    color=df_variable['color_hex'],\n","                    line=dict(width=1, color='black')\n","                ),\n","                hovertemplate=(\n","                    \"<b>%{text}</b><br>\" +\n","                    \"Rank: %{x}<br>\" +\n","                    variable.capitalize() + \": %{y}<extra></extra>\"\n","                ),\n","                name=f\"{variable.replace('_', ' ').capitalize()}\",\n","                showlegend=False\n","            ),\n","            row=2, col=j+1\n","        )\n","\n","    variable_titles = [\"Area\", \"Density (ihb/ha)\", \"Density (ihb/km^2)\", \"Population\"]\n","    for j in range(4):\n","        fig.update_geos(\n","            showland=True,\n","            landcolor=\"lightgrey\",\n","            projection_type=\"equal earth\",\n","            row=1, col=j+1\n","        )\n","        fig.update_xaxes(title_text=\"Rank\", row=2, col=j+1)\n","        fig.update_yaxes(title_text=variable_titles[j], row=2, col=j+1)\n","\n","    fig.update_layout(\n","        height=900 * resolution,\n","        width=2400 * resolution,\n","        legend_title_text='Region',\n","        title_text=\"Top 120 Cities by Max. Area, Density, and Population\",\n","        margin=dict(t=80, b=40, l=40, r=40)\n","    )\n","\n","    fig.show()"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":690},"id":"bf34a917","executionInfo":{"status":"error","timestamp":1758468297110,"user_tz":-60,"elapsed":1350,"user":{"displayName":"Confoederatio","userId":"16561974736841499613"}},"outputId":"c6a672ba-771c-40ba-884a-31863e657dc2"},"source":["variables = ['area', 'density', 'density_ghsl', 'population']\n","\n","for variable in variables:\n","    df_variable = df[df['variable_name'] == variable].copy()\n","    if not df_variable.empty:\n","        df_variable = df_variable.sort_values(by='variable_value', ascending=False).reset_index(drop=True)\n","        df_variable['rank'] = df_variable.index + 1\n","        print(f\"Table for {variable.replace('_', ' ').capitalize()} by Rank:\")\n","        display(df_variable[['rank', 'name', 'variable_value', 'region']])\n","    else:\n","        print(f\"No data to display for variable: {