6) | (b << 8) | a) >>> 0\n","    # In Python, the unsigned right shift (>>> 0) is not directly available for standard integers\n","    # and bitwise operations handle negative numbers differently. However, for positive integers\n","    # resulting from the left shifts and OR operations, the result will be a positive integer\n","    # that matches the unsigned interpretation if it fits within the integer limits.\n","    # We can simulate the unsigned 32-bit behavior if necessary, but for the given decoding,\n","    # a standard Python integer should suffice if the values are within the typical range\n","    # of population numbers.\n","\n","    decoded_value = (r << 24) | (g << 16) | (b << 8) | a\n","\n","    # If we need to ensure it's treated as an unsigned 32-bit integer, we can use\n","    # a mask or check for overflow, but for typical use cases, the direct calculation\n","    # should be sufficient as Python integers can be arbitrarily large.\n","    # If the resulting value can exceed the maximum signed 32-bit integer (2^31 - 1),\n","    # and the unsigned interpretation is critical, we might need a different approach\n","    # like using the `ctypes` module to work with unsigned integers.\n","    # Assuming the decoded values will fit within a standard integer representation\n","    # and the unsigned aspect is mainly about interpreting the bit pattern.\n","    return decoded_value"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"0fb81dfd"},"source":["## Filter png files for benchmark years\n","\n","### Subtask:\n","From the list of PNG files, filter for those corresponding to the benchmark years: 0, 1000, 1500, 1800, 1900, 1950, 1975, 2025.\n"]},{"cell_type":"markdown","metadata":{"id":"eeac7847"},"source":["**Reasoning**:\n","Filter the list of PNG files to include only those corresponding to the benchmark years.\n","\n"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3b31afdd","executionInfo":{"status":"ok","timestamp":1757483787036,"user_tz":-60,"elapsed":8,"user":{"displayName":"Confoederatio","userId":"16561974736841499613"}},"outputId":"4d77c19c-b394-4422-f385-6374fac9ceab"},"source":["benchmark_years = [0, 1000, 1500, 1800, 1900, 1950, 1975, 2025]\n","# Modify the filtering logic to be more precise\n","benchmark_png_files = [f for f in png_files if f.startswith('stadester_') and f.endswith('.png') and int(f.split('_')[1].split('.')[0]) in benchmark_years]\n","\n","print(benchmark_png_files)"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["['stadester_1975.png', 'stadester_2025.png', 'stadester_0.png', 'stadester_1000.png', 'stadester_1500.png', 'stadester_1800.png', 'stadester_1900.png', 'stadester_1950.png']\n"]}]},{"cell_type":"markdown","metadata":{"id":"4a7948ad"},"source":["## Process benchmark PNG files\n","\n","### Subtask:\n","Iterate through the filtered PNG files, open each file, read the pixel data, apply the decoding function to each pixel, and store the resulting numeric data along with the geographic information for each benchmark year."]},{"cell_type":"markdown","metadata":{"id":"9784b36e"},"source":["**Reasoning**:\n","Process each benchmark year PNG file by opening it, loading the pixel data, and applying the `decode_rgba` function to each pixel to obtain the numeric value. Store the decoded data along with the corresponding year."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"314578eb","executionInfo":{"status":"ok","timestamp":1757483791311,"user_tz":-60,"elapsed":4280,"user":{"displayName":"Confoederatio","userId":"16561974736841499613"}},"outputId":"9c8fe1f0-f04b-40ad-d15d-e4715be6c907"},"source":["from PIL import Image\n","import numpy as np\n","import os\n","\n","decoded_data = {}\n","\n","for file_name in benchmark_png_files:\n","    year_str = file_name.split('_')[1].split('.')[0]\n","    year = int(year_str)\n","\n","    # Construct the full path to the image file\n","    image_path = os.path.join(directory_path, file_name)\n","\n","    try:\n","        print(f\"Processing {file_name}...\")\n","        img = Image.open(image_path).convert('RGBA')\n","        img_data = np.array(img)\n","\n","        # Use vectorized operations to decode RGBA values\n","        # Reshape to a 2D array of RGBA tuples\n","        img_data_reshaped = img_data.reshape(-1, 4)\n","\n","        # Apply the decoding function using vectorized operations\n","        # This assumes decode_rgba can handle numpy arrays element-wise\n","        # Let's redefine decode_rgba to work with arrays if needed, or use numpy operations directly\n","        # Based on the JS function: ((r << 24) | (g << 16) | (b << 8) | a) >>> 0\n","        # We can perform these bitwise operations directly on the numpy array\n","\n","        r, g, b, a = img_data_reshaped[:, 0], img_data_reshaped[:, 1], img_data_reshaped[:, 2], img_data_reshaped[:, 3]\n","\n","        # Perform the bitwise operations\n","        decoded_values_flat = (r.astype(np.uint32) << 24) | (g.astype(np.uint32) << 16) | (b.astype(np.uint32) << 8) | a.astype(np.uint32)\n","\n","        # Reshape back to the original image dimensions\n","        decoded_values = decoded_values_flat.reshape(img_data.shape[:2])\n","\n","        decoded_data[year] = decoded_values\n","\n","    except FileNotFoundError:\n","        print(f\"Error: File not found at {image_path}\")\n","    except Exception as e:\n","        print(f\"An error occurred while processing {file_name}: {e}\")\n","\n","# You can inspect the decoded_data dictionary to see the results\n","# for example, print the shape of the array for a specific year:\n","# print(decoded_data[0].shape)"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Processing stadester_1975.png...\n","Processing stadester_2025.png...\n","Processing stadester_0.png...\n","Processing stadester_1000.png...\n","Processing stadester_1500.png...\n","Processing stadester_1800.png...\n","Processing stadester_1900.png...\n","Processing stadester_1950.png...\n"]}]},{"cell_type":"markdown","metadata":{"id":"92a94aaa"},"source":["## Create GeoDataFrames\n","\n","### Subtask:\n","Create separate GeoDataFrames for each benchmark year from the processed data, including the numeric values and corresponding geometries."]},{"cell_type":"markdown","metadata":{"id":"3badfece"},"source":["**Reasoning**:\n","Convert the decoded pixel data for each benchmark year into GeoDataFrames. This requires creating a geometry for each pixel (e.g., a point or a small polygon representing the pixel's area) and associating it with the decoded numeric value. Since the image is a WGS84 Equirectangular raster, we can derive approximate latitude and longitude for each pixel based on its position and the image dimensions."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6355f870","executionInfo":{"status":"ok","timestamp":1757483822143,"user_tz":-60,"elapsed":30830,"user":{"displayName":"Confoederatio","userId":"16561974736841499613"}},"outputId":"9dc3c5c3-6a51-4603-9ec9-3f99ad29253e"},"source":["import geopandas as gpd\n","from shapely.geometry import Point\n","\n","geodataframes = {}\n","\n","# Assuming the image represents a global coverage with a WGS84 Equirectangular projection\n","# The extent of the image in degrees would be approximately -180 to 180 longitude and -90 to 90 latitude.\n","# We can calculate the approximate latitude and longitude for the center of each pixel.\n","# Image dimensions are 4320x2160.\n","\n","# Calculate the resolution in degrees per pixel\n","lon_resolution = 360 / img.width  # 360 degrees / 4320 pixels\n","lat_resolution = 180 / img.height # 180 degrees / 2160 pixels\n","\n","# Define coordinates for dummy points\n","# Top-left corner (pixel 0,0) corresponds to approx -180, 90\n","# Bottom-right corner (pixel 4319, 2159) corresponds to approx 180, -90\n","dummy_points_coords = [\n","    (-180 + 0.5 * lon_resolution, 90 - 0.5 * lat_resolution), # Top-left pixel center\n","    (-180 + (img.width - 0.5) * lon_resolution, 90 - (img.height - 0.5) * lat_resolution) # Bottom-right pixel center\n","]\n","\n","\n","for year, data in decoded_data.items():\n","    print(f\"Creating GeoDataFrame for year {year}...\")\n","    # Create a list to store geometry and value for each pixel\n","    geometry_value_list = []\n","    for y in range(data.shape[0]):\n","        for x in range(data.shape[1]):\n","            value = data[y, x]\n","            if value > 0: # Only include pixels with non-zero values\n","                # Calculate approximate latitude and longitude for the center of the pixel\n","                # Longitude: -180 + (x + 0.5) * lon_resolution\n","                # Latitude: 90 - (y + 0.5) * lat_resolution\n","                # (0,0) is typically top-left, so latitude decreases as y increases\n","                lon = -180 + (x + 0.5) * lon_resolution\n","                lat = 90 - (y + 0.5) * lat_resolution\n","                geometry_value_list.append({'geometry': Point(lon, lat), 'value': value})\n","\n","    # Add dummy points with a value of 0\n","    for dummy_lon, dummy_lat in dummy_points_coords:\n","         geometry_value_list.append({'geometry': Point(dummy_lon, dummy_lat), 'value': 0})\n","\n","\n","    # Create a GeoDataFrame\n","    gdf = gpd.GeoDataFrame(geometry_value_list, crs=\"EPSG:4326\") # WGS84 coordinate system\n","    geodataframes[year] = gdf\n","    print(f\"Created GeoDataFrame for year {year} with {len(gdf)} entries (including dummy points).\")\n","\n","# You can access the GeoDataFrame for a specific year like this:\n","# gdf_1975 = geodataframes[1975]\n","# print(gdf_1975.head())"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Creating GeoDataFrame for year 1975...\n","Created GeoDataFrame for year 1975 with 8727 entries (including dummy points).\n","Creating GeoDataFrame for year 2025...\n","Created GeoDataFrame for year 2025 with 18805 entries (including dummy points).\n","Creating GeoDataFrame for year 0...\n","Created GeoDataFrame for year 0 with 102 entries (including dummy points).\n","Creating GeoDataFrame for year 1000...\n","Created GeoDataFrame for year 1000 with 1374 entries (including dummy points).\n","Creating GeoDataFrame for year 1500...\n","Created GeoDataFrame for year 1500 with 2214 entries (including dummy points).\n","Creating GeoDataFrame for year 1800...\n","Created GeoDataFrame for year 1800 with 2656 entries (including dummy points).\n","Creating GeoDataFrame for year 1900...\n","Created GeoDataFrame for year 1900 with 8027 entries (including dummy points).\n","Creating GeoDataFrame for year 1950...\n","Created GeoDataFrame for year 1950 with 12283 entries (including dummy points).\n"]}]},{"cell_type":"markdown","metadata":{"id":"6d64fe54"},"source":["## Visualize data in a 2x4 array\n","\n","### Subtask:\n","Create a 2x4 grid of subplots using Matplotlib. Iterate through the GeoDataFrames for each benchmark year and plot each as a heatmap with a logarithmic color scale on its corresponding subplot using Geopandas. Add titles to each subplot indicating the year."]},{"cell_type":"markdown","metadata":{"id":"f014b140"},"source":["**Reasoning**:\n","Create a figure and a grid of subplots. Iterate through the `geodataframes` dictionary, sort the years to maintain order in the subplots, and plot each GeoDataFrame on its respective subplot using `geopandas.GeoDataFrame.plot`. Specify the 'value' column for coloring, use a logarithmic color scale, and set the title for each subplot."]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1y0SWDR5NKJEHpXz-F51zC1kX5Y3TkAxH"},"id":"1e04b56d","executionInfo":{"status":"ok","timestamp":1757483827247,"user_tz":-60,"elapsed":5101,"user":{"displayName":"Confoederatio","userId":"16561974736841499613"}},"outputId":"f5eb5743-5da2-4c14-d573-1ac4e840b779"},"source":["import plotly.graph_objects as go\n","from plotly.subplots import make_subplots\n","import numpy as np\n","import matplotlib.ticker as mticker # Import for human_format function\n","\n","# Define the layout of the subplots\n","n_rows = 4\n","n_cols = 2\n","\n","# Sort the years to ensure consistent plotting order\n","sorted_years = sorted(geodataframes.keys())\n","\n","# Create subplots with 'geo' type\n","subplot_titles = []\n","for year in sorted_years:\n","    gdf = geodataframes[year]\n","    gdf_filtered = gdf[gdf['value'] > 0]\n","    n_points = len(gdf_filtered)\n","    era = \"AD\" if year >= 0 else \"BC\"\n","    subplot_titles.append(f\"{'Stadestér-GHSL<br>' if year >= 1975 else 'Stadestér<br>'}{1 if year == 0 else year}{era}, n={n_points}\")\n","fig = make_subplots(rows=n_rows, cols=n_cols,\n","    subplot_titles=subplot_titles,\n","    vertical_spacing=0, # Increased vertical spacing\n","    specs=[[{'type': 'geo'}] * n_cols] * n_rows) # Specify 'geo' type for all subplots\n","\n","# Function to format tick labels\n","def human_format(num, pos):\n","    if num == 0:\n","        return '0'\n","    magnitude = 0\n","    while abs(num) >= 1000:\n","        magnitude += 1\n","        num /= 1000.0\n","    return '%.0f%s' % (num, ['', 'K', 'M', 'B', 'T'][magnitude])\n","\n","\n","# Iterate through the sorted years and plot the heatmaps\n","for i, year in enumerate(sorted_years):\n","    row = i // n_cols + 1\n","    col = i % n_cols + 1\n","    gdf = geodataframes[year]\n","\n","    # Filter out dummy points with value 0 for visualization\n","    gdf_filtered = gdf[gdf['value'] > 0].copy() # Create a copy to avoid SettingWithCopyWarning\n","\n","    # Apply log10 transformation to the 'value' column, handling potential zeros by replacing with NaN\n","    gdf_filtered['log_value'] = np.log10(gdf_filtered['value'].replace(0, np.nan))\n","\n","    # Calculate colorbar position\n","    # x: position from left (0 to 1), y: position from bottom (0 to 1)\n","    # Adjust these values based on the number of rows and columns and desired spacing\n","    if col == 1:\n","        colorbar_x = 0.45 # Position for the first column\n","    else: # col == 2\n","        colorbar_x = 1 # Position for the second column\n","\n","    colorbar_y = 1 - (row - 0.5) / n_rows   # Center vertically within the row\n","\n","\n","    # Determine tick values and text for the colorbar\n","    # Get the range of original population values for the current year\n","    min_pop = gdf_filtered['value'].min() if not gdf_filtered.empty else 1\n","    max_pop = gdf_filtered['value'].max() if not gdf_filtered.empty else 10\n","\n","    # Generate tick values in a log scale, covering the range of population values\n","    # We'll use powers of 10 as potential tick locations\n","    log_min_pop = np.floor(np.log10(min_pop)) if min_pop > 0 else 0\n","    log_max_pop = np.ceil(np.log10(max_pop)) if max_pop > 0 else 1\n","\n","    # Generate tick values on the log scale\n","    tickvals_log = np.arange(log_min_pop, log_max_pop + 1)\n","\n","    # Convert log tick values back to original scale and format the text\n","    ticktext_formatted = [human_format(val, None) for val in 10**tickvals_log]\n","\n","    # Ensure tick values are within the actual log_value range\n","    valid_tick_indices = np.where((tickvals_log >= gdf_filtered['log_value'].min()) & (tickvals_log <= gdf_filtered['log_value'].max()))[0]\n","    tickvals_log = tickvals_log[valid_tick_indices]\n","    ticktext_formatted = [ticktext_formatted[i] for i in valid_tick_indices]\n","\n","    # Set the labels for the topmost and bottommost auto-generated ticks to \"\"\n","    if len(ticktext_formatted) > 0:\n","        ticktext_formatted[0] = \"\"\n","        if len(ticktext_formatted) > 1: # Check if there's more than one tick\n","            ticktext_formatted[-1] = \"\"\n","\n","\n","    # Convert min_pop and max_pop to log scale\n","    log_min_pop_actual = np.log10(min_pop) if min_pop > 0 else None\n","    log_max_pop_actual = np.log10(max_pop) if max_pop > 0 else None\n","\n","    # Add actual min and max to tick values and their formatted text\n","    if log_min_pop_actual is not None:\n","        tickvals_log = np.insert(tickvals_log, 0, log_min_pop_actual)\n","        ticktext_formatted = [human_format(min_pop, None)] + ticktext_formatted\n","\n","    if log_max_pop_actual is not None:\n","        tickvals_log = np.append(tickvals_log, log_max_pop_actual)\n","        ticktext_formatted = ticktext_formatted + [human_format(max_pop, None)]\n","\n","\n","    # Sort tickvals_log and ticktext_formatted based on tickvals_log\n","    sort_indices = np.argsort(tickvals_log)\n","    tickvals_log = tickvals_log[sort_indices]\n","    ticktext_formatted = [ticktext_formatted[i] for i in sort_indices]\n","\n","\n","    # Add heatmap trace to the subplot\n","    fig.add_trace(go.Scattergeo(\n","        lon = gdf_filtered.geometry.x,\n","        lat = gdf_filtered.geometry.y,\n","        text = gdf_filtered['value'],\n","        mode = 'markers',\n","        marker = dict(\n","            size = 2,\n","            color = gdf_filtered['log_value'], # Use the log-transformed value for color\n","            colorscale = 'deep',\n","            colorbar=dict(\n","                title='Pop.',\n","                thickness=10,\n","                ticks='outside',\n","                x=colorbar_x, # Set colorbar horizontal position\n","                y=colorbar_y, # Set colorbar vertical position\n","                len=0.2, # Set colorbar length (fraction of the plot height)\n","                tickmode='array',\n","                tickvals=tickvals_log, # Set tick values on the log scale\n","                ticktext=ticktext_formatted, # Set tick text with human-readable format\n","            ),\n","            showscale=True,\n","            cauto=False,\n","            cmin=gdf_filtered['log_value'].min() if not gdf_filtered.empty and not np.isnan(gdf_filtered['log_value'].min()) else 0, # Set cmin for log scale, handle NaN\n","            cmax=gdf_filtered['log_value'].max() if not gdf_filtered.empty and not np.isnan(gdf_filtered['log_value'].max()) else 1, # Set cmax for log scale, handle NaN\n","        )),\n","        row=row, col=col\n","    )\n","\n","    # Update subplot layout for better appearance\n","    fig.update_geos(\n","        row=row, col=col,\n","        scope='world',\n","        showland=True, landcolor=\"lightgray\",\n","        showocean=True, oceancolor=\"lightblue\",\n","        showcountries=True, countrycolor=\"darkgray\",\n","        showsubunits=True, subunitcolor=\"darkgray\",\n","        showcoastlines=True, coastlinecolor=\"darkgray\",\n","        lataxis_range=[-60, 90], # Adjust latitude range for better view\n","        lonaxis_range=[-180, 180],\n","        projection_type=\"equirectangular\",\n","        center=dict(lat=0, lon=0),\n","        lataxis=dict( # Configure latitude axis grid lines and ticks\n","            showgrid=True, gridwidth=1, gridcolor='rgba(100, 100, 100, 0.5)',\n","            tick0=0, dtick=30 # Set tick origin and interval for latitude (every 30 degrees)\n","        ),\n","        lonaxis=dict( # Configure longitude axis grid lines and ticks\n","            showgrid=True, gridwidth=1, gridcolor='rgba(100, 100, 100, 0.5)',\n","            tick0=0, dtick=60 # Set tick origin and interval for longitude (every 60 degrees)\n","        )\n","    )\n","\n","    # Add text labels for latitude and longitude using Scattergeo with mode='text'\n","    dtick_lat = 30\n","    dtick_lon = 60\n","\n","    # Latitude labels on the left\n","    lat_labels = list(range(-60, 90 + dtick_lat, dtick_lat))\n","    lon_for_lat_labels = [-175 + 5] * len(lat_labels) # Place labels on the left side\n","    fig.add_trace(\n","        go.Scattergeo(\n","            lon=lon_for_lat_labels,\n","            lat=lat_labels,\n","            text=[f'{lat}°N' if lat >= 0 else f'{abs(lat)}°S' for lat in lat_labels],\n","            mode='text',\n","            textfont=dict(size=8),\n","            showlegend=False,\n","        ), row=row, col=col\n","    )\n","\n","    # Longitude labels on the top\n","    lon_labels = list(range(-180, 180 + dtick_lon, dtick_lon))\n","    lat_for_lon_labels = [-85 + 10] * len(lon_labels)  # Place labels on the top side\n","\n","    def format_lon_label(lon):\n","        if lon == -180:\n","            return '            180°W'  # 12 spaces on the left\n","        elif lon == 180:\n","            return '180°E            '  # 12 spaces on the right\n","        elif lon >= 0:\n","            return f'{lon}°E'\n","        else:\n","            return f'{abs(lon)}°W'\n","\n","    fig.add_trace(\n","        go.Scattergeo(\n","            lon=lon_labels,\n","            lat=lat_for_lon_labels,\n","            text=[format_lon_label(lon) for lon in lon_labels],\n","            mode='text',\n","            textfont=dict(size=8),\n","            showlegend=False,\n","        ), row=row, col=col\n","    )\n","\n","\n","# Update layout for the entire figure\n","resolution = 1\n","fig.update_layout(\n","    title_text='Stadestér Urban Population Heatmaps by Year (Log Scale)',\n","    title_x=0.5,\n","    height=n_rows * 300 * resolution, # Adjusted height to accommodate labels\n","    width=n_cols * 600 * resolution, # Adjust figure width based on the number of columns\n","    showlegend=False,\n","    margin=dict(l=60, r=20, t=80, b=40), # Adjusted margins\n",")\n","for annotation in fig.layout.annotations:\n","    # Default y is something like 1.0, reduce it slightly\n","    annotation.y -= 0.02  # Move title closer to subplot (adjust value as needed)\n","\n","fig.show()"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}]},{"cell_type":"code","