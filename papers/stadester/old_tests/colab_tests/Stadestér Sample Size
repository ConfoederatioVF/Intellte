rk_lons.append(lon)\n","    benchmark_lats.append(lat)\n","    benchmark_year_labels.append(year)\n","\n","\n","fig = go.Figure()\n","\n","# Plot lines for all consecutive points\n","fig.add_trace(go.Scattergeo(\n","    lon=all_lons,\n","    lat=all_lats,\n","    mode='lines',\n","    line=dict(width=1.5, color=\"rgba(0, 0, 0, 0.5)\"),\n","    name='Path of Centre'  # Add name for legend\n","))\n","\n","# Plot points with year labels for benchmark years only\n","fig.add_trace(go.Scattergeo(\n","    lon=benchmark_lons,\n","    lat=benchmark_lats,\n","    text=benchmark_year_labels,\n","    textfont={\"color\": 'black', \"size\": 12},\n","    textposition=\"bottom left\",\n","    mode=\"markers+text\",\n","    marker=dict(\n","        size=4,\n","        color=\"black\",\n","        line_color='black',\n","        line_width=0.5,\n","        opacity=0.5  # <-- Add this line for transparency\n","    ),\n","    name='Benchmark Years'\n","))\n","\n","# Draw arrows between consecutive points from the complete list of years\n","arrow_margin = 8  # Adjustable margin for arrows\n","# Define arrow properties - ARROW_LENGTH AND ARROW_WIDTH MUST REMAIN THE SAME!!\n","arrow_length = 0.5\n","arrow_width = 0.2\n","\n","\n","for i in range(len(all_lons) - 1):\n","    # Only draw arrows at arrow_years\n","    if all_years[i+1] in arrow_years:\n","        # Arrowhead\n","        A = np.array([all_lons[i], all_lats[i]])\n","        B = np.array([all_lons[i+1], all_lats[i+1]])\n","        v = B - A\n","        norm_v = np.linalg.norm(v)\n","        if norm_v == 0:\n","            continue\n","        w = v / norm_v\n","\n","        # Adjust the start point of the arrow based on the margin\n","        arrow_start = A + arrow_margin * w\n","\n","        u = np.array([-w[1], w[0]])  # orthogonal\n","        P = B - arrow_length * w\n","        S = P - arrow_width * u\n","        T = P + arrow_width * u\n","\n","        fig.add_trace(go.Scattergeo(\n","            lon=[arrow_start[0], B[0], S[0], T[0], B[0], S[0]],\n","            lat=[arrow_start[1], B[1], S[1], T[1], B[1], S[1]],\n","            mode='lines',\n","            fill='toself',\n","            fillcolor='rgba(0, 0, 0, 0.5)',\n","            line_color=\"rgba(0, 0, 0, 0)\",\n","            showlegend=False # Don't show legend for individual arrows\n","        ))\n","\n","\n","fig.update_layout(\n","    title_text='Centres of Population (Stadestér Base, 3000BC-2023AD)',\n","    title_x=0.5,\n","    title_y=0.925,\n","    width=800,\n","    height=500,\n","    showlegend=True,\n","    legend=dict(\n","        x=0.92,\n","        y=0.02,\n","        xanchor='right',\n","        yanchor='bottom',\n","        bgcolor='rgba(255, 255, 255, 0.7)',\n","        bordercolor='Black',\n","        borderwidth=1\n","    ),\n","    margin=dict(t=60, b=30, l=30, r=30),\n","    geo=dict(\n","        projection_type='equirectangular',\n","        scope='world',\n","        showland=True, landcolor=\"lightgray\",\n","        showocean=True, oceancolor=\"lightblue\",\n","        showcountries=True, countrycolor=\"darkgray\",\n","        showsubunits=True, subunitcolor=\"darkgray\",\n","        showcoastlines=True, coastlinecolor=\"darkgray\",\n","        lataxis=dict(\n","            range=[11.7600959276, 52.2775203418],\n","            showgrid=True,\n","            gridwidth=1,\n","            gridcolor='rgba(100, 100, 100, 0.5)',\n","            dtick=30  # Graticule every 30 degrees latitude 12.0503639481,11.7600959276,62.6582745216,42.2775203418\n","        ),\n","        lonaxis=dict(\n","            range=[10.0503639481, 72.6582745216],\n","            showgrid=True,\n","            gridwidth=1,\n","            gridcolor='rgba(100, 100, 100, 0.5)',\n","            dtick=60  # Graticule every 60 degrees longitude\n","        )\n","    )\n",")\n","\n","# Latitude labels on the left\n","dtick_lat = 30\n","lat_labels = list(range(-90, 91, dtick_lat))\n","lon_for_lat_labels = [-175 + 5] * len(lat_labels)  