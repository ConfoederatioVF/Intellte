{
  // Operation Viscount Project NICETHI — Pre-Modern (<1950AD) Settlement Estimate Series & Auditor Targets
  // Grounded in NICETHI's regional macro-population series (nicethi_root_summary.json),
  // African archaeological & historical-demography literature, and peer Viscount benchmarks
  // (PRETA, AUSTRAL, POLARIS, QUIPU, CENTAUR, JAGUAR, MANDALA).
  project: "NICETHI",
  scope: "Sub-Saharan Africa, Sudan, Sahel, Horn, Madagascar, Western Indian Ocean & African Atlantic Islands",
  baseline_pre1950_unique_before: 1738,
  target_pre1950_unique_min: 8000,
  target_unified_total_min: 19500,

  // Part 1a: Scholarly macro-estimate series of total pre-modern nucleated settlements (>= 50 inh. villages,
  // walled towns, stone towns, chiefdom capitals, royal compounds, oasis entrepots & colonial stations)
  // across Sub-Saharan Africa & Madagascar, anchored to regional macro-population / mean nucleated settlement size.
  estimated_historical_settlements_series: {
    methodology: "Derived from NICETHI macro-population benchmarks multiplied by era-specific nucleated habitation share (0.35 in 3000BC rising to 0.85 in 1950AD) divided by mean nucleated settlement size (35 inh. in Late Neolithic/Pastoral camps rising to 120 inh. in 1500AD agrarian-urban polities and 220 inh. in 1950AD colonial towns).",
    benchmarks: {
      "-3000": { macro_pop_est: 1000000, nucleated_share: 0.35, mean_settlement_size: 35, estimated_total_settlements: 10000, target_recovery_rate_pct: 4.50 },
      "-2000": { macro_pop_est: 1500000, nucleated_share: 0.40, mean_settlement_size: 42, estimated_total_settlements: 14300, target_recovery_rate_pct: 4.55 },
      "-1000": { macro_pop_est: 2400000, nucleated_share: 0.48, mean_settlement_size: 52, estimated_total_settlements: 22200, target_recovery_rate_pct: 4.50 },
      "0":     { macro_pop_est: 10400000, nucleated_share: 0.58, mean_settlement_size: 72, estimated_total_settlements: 83800, target_recovery_rate_pct: 1.73 },
      "500":   { macro_pop_est: 13200000, nucleated_share: 0.62, mean_settlement_size: 82, estimated_total_settlements: 99800, target_recovery_rate_pct: 1.85 },
      "1000":  { macro_pop_est: 20700000, nucleated_share: 0.66, mean_settlement_size: 95, estimated_total_settlements: 143800, target_recovery_rate_pct: 1.67 },
      "1300":  { macro_pop_est: 31000000, nucleated_share: 0.70, mean_settlement_size: 110, estimated_total_settlements: 197300, target_recovery_rate_pct: 1.42 },
      "1500":  { macro_pop_est: 38000000, nucleated_share: 0.72, mean_settlement_size: 120, estimated_total_settlements: 228000, target_recovery_rate_pct: 1.49 },
      "1700":  { macro_pop_est: 69900000, nucleated_share: 0.74, mean_settlement_size: 135, estimated_total_settlements: 383200, target_recovery_rate_pct: 0.84 },
      "1800":  { macro_pop_est: 63200000, nucleated_share: 0.74, mean_settlement_size: 135, estimated_total_settlements: 346400, target_recovery_rate_pct: 1.04 },
      "1850":  { macro_pop_est: 61400000, nucleated_share: 0.75, mean_settlement_size: 140, estimated_total_settlements: 328900, target_recovery_rate_pct: 1.28 },
      "1900":  { macro_pop_est: 78200000, nucleated_share: 0.78, mean_settlement_size: 155, estimated_total_settlements: 393500, target_recovery_rate_pct: 1.32 },
      "1920":  { macro_pop_est: 95000000, nucleated_share: 0.80, mean_settlement_size: 170, estimated_total_settlements: 447100, target_recovery_rate_pct: 1.30 },
      "1940":  { macro_pop_est: 122000000, nucleated_share: 0.82, mean_settlement_size: 195, estimated_total_settlements: 513000, target_recovery_rate_pct: 1.27 },
      "1950":  { macro_pop_est: 141800000, nucleated_share: 0.85, mean_settlement_size: 220, estimated_total_settlements: 547900, target_recovery_rate_pct: 1.37 }
    }
  },

  // Peer comparison snapshot across Operation Viscount regions (active spanning settlements by benchmark year)
  peer_comparison_snapshot: {
    NICETHI_before: { "-1000": 66, "0": 79, "500": 82, "1000": 120, "1500": 295, "1700": 414, "1800": 563, "1850": 695, "1900": 893, "1950": 1349 },
    QUIPU:          { "-1000": 1908, "0": 2820, "500": 3813, "1000": 4760, "1500": 5376, "1700": 4304, "1800": 4991, "1850": 10593, "1900": 13778, "1950": 19220 },
    PRETA:          { "-1000": 487, "0": 628, "500": 3451, "1000": 5132, "1500": 1058, "1700": 1404, "1800": 1632, "1850": 2715, "1900": 6069, "1950": 6508 },
    AUSTRAL:        { "-1000": 852, "0": 1100, "500": 1269, "1000": 1646, "1500": 3197, "1700": 3296, "1800": 3076, "1850": 3150, "1900": 3152, "1950": 8028 },
    POLARIS:        { "-1000": 615, "0": 613, "500": 382, "1000": 2382, "1500": 1725, "1700": 3872, "1800": 5685, "1850": 6022, "1900": 7536, "1950": 7195 }
  },

  // Part 1a Auditor Target: hard minimum active discrete documented settlements per pre-modern benchmark year
  benchmark_year_quotas: {
    "-3000": 450,
    "-2000": 650,
    "-1000": 1000,
    "0": 1450,
    "500": 1850,
    "1000": 2400,
    "1300": 2800,
    "1500": 3400,
    "1700": 3200,
    "1800": 3600,
    "1850": 4200,
    "1900": 5200,
    "1920": 5800,
    "1940": 6500,
    "1950": 7500
  },

  // Balanced continental pre-1950 unique documented settlement floors across all 6 African macro-subregions
  pre1950_subregion_quotas: {
    west_africa_forest_coast: 1800,
    sahel_western_sudan: 1200,
    nubia_sudan_horn: 1100,
    central_africa_congo_angola: 1200,
    east_africa_swahili_great_lakes: 1300,
    southern_africa_madagascar_islands: 1400
  }
}
