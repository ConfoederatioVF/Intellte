{
  // Non-Stationary Matérn (nu = 3/2) Archaeological & Ethnohistorical Kriging Configuration for Pre-Annexation Hawai'i & American Polynesia (CENTAUR-II)
  // Covers the 8 main Hawaiian Islands and Eastern Samoa (Tutuila, Aunu'u & Manu'a) across 800-1898 AD,
  // with Western Samoan (Upolu/Savai'i) >= 200 km cross-frontier conditioning buffers.
  geojson_metadata_filename: "config/sites_hawaii_polynesia_geojson_metadata.json",
  include_all_periods_geojson: true,
  kriging_metadata_filename: "config/kriging_diagnostics.json",
  output_geojson_subfolder: "geojson",
  output_kriged_rasters_subfolder: "1.kriged_rasters",
  output_population_rasters_subfolder: "2.population_rasters",
  png_compression_level: 6,

  kriging_config: {
    preserve_period_dynamics: true,
    hu_admixture_config: "histmap/3.data_transform/population_Substrata.viscount/centaur/config/centaur_hu_admixture.json5",
    residual_kriging_mode: "hu_hyde_residual",
    residual_kriging_module: "histmap/3.data_transform/population_Substrata.viscount/centaur/ViscountHUResidualKriging.js",
    all_hyde_years: [
      -10000, -9000, -8000, -7000, -6000, -5000, -4000, -3000, -2000, -1000,
      0, 100, 200, 300, 400, 500, 600, 700, 800, 900,
      1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700,
      1710, 1720, 1730, 1740, 1750, 1760, 1770, 1780, 1790,
      1800, 1810, 1820, 1830, 1840, 1850, 1860, 1870, 1880, 1890,
      1900, 1910, 1920, 1930, 1940, 1950, 1951, 1952, 1953, 1954, 1955,
      1956, 1957, 1958, 1959, 1960, 1961, 1962, 1963, 1964, 1965, 1966,
      1967, 1968, 1969, 1970, 1971, 1972, 1973, 1974, 1975, 1976, 1977,
      1978, 1979, 1980, 1981, 1982, 1983, 1984, 1985, 1986, 1987, 1988,
      1989, 1990, 1991, 1992, 1993, 1994, 1995, 1996, 1997, 1998, 1999,
      2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010,
      2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021,
      2022, 2023, 2024, 2025
    ],
    covariate_paths: {
      forest_asc: "histmap/1.data_raw/metadata_HYDE/general_files/forest_wwf_cr.asc",
      ghsl_urban_2020_raster: "histmap/1.data_raw/population_GHSL/urban_rasters/GHSL_2020.png",
      ghsl_urban_folder: "histmap/1.data_raw/population_GHSL/urban_rasters",
      ghsl_urban_pop_threshold: 35000,
      hyde_mcevedy_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_mcevedy",
      hyde_popc_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_scaled_to_global",
      hyde_raw_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters",
      hyde_uopp_raster: "histmap/2.data_cleaning/landuse_HYDE/rasters/uopp_2023AD.png",
      lakes_geojson: "histmap/1.data_raw/population_regional/POLARIS/_shared/_gis_cache/ne_10m_lakes.geojson",
      landlake_asc: "histmap/1.data_raw/metadata_HYDE/general_files/landlake.asc",
      maxln_asc: "histmap/1.data_raw/metadata_HYDE/general_files/maxln_cr.asc",
      nelson_legacy_raster: "histmap/1.data_raw/population_regional/CENTAUR/_shared/centaur_i_legacy/nelson_northern_america.png",
      nelson_regions_png: "histmap/2.data_cleaning/population_KK10LUH2/config/nelson_regions.png",
      rivers_geojson: "histmap/1.data_raw/population_regional/POLARIS/_shared/_gis_cache/ne_10m_rivers_lake_centerlines.geojson",
      sub_iso_asc: "histmap/1.data_raw/metadata_HYDE/general_files/sub_iso_cr.asc",
      urban_fringe_uopp_threshold: 1.5,
      urban_mask_buffer_radius: 3,
      urban_mask_inpaint_radius: 6,
      urban_uopp_threshold: 8.0
    },
    dimensionless_lag_bins: [0.65, 1.15, 1.80, 2.75, 4.10, 6.00, 8.80, 12.50, 17.50, 24.00],
    domain_mask_png: "histmap/1.data_raw/population_regional/CENTAUR/_shared/sites_hawaii_polynesia/config/centaur_hp_domain_mask.png",
    earth_radius_km: 6371,
    frontier_conditioning_max_dist_km: 250,
    grid_height: 2160,
    grid_width: 4320,

    chronological_horizons: [
      { active_periods: ["colonisation_founder"], key: "colonisation_founder_horizon", year: 950 },
      { active_periods: ["expansion_wetland"], key: "expansion_wetland_horizon", year: 1300 },
      { active_periods: ["dryland_intensification"], key: "dryland_intensification_horizon", year: 1550 },
      { active_periods: ["protohistoric_archaic_state"], key: "protohistoric_archaic_state_horizon", year: 1750 },
      { active_periods: ["kingdom_missionary_era"], key: "kingdom_missionary_era_horizon", year: 1835 },
      { active_periods: ["late_kingdom_plantation"], key: "late_kingdom_plantation_horizon", year: 1890 }
    ]
  },

  periods: [
    {
      approx_end_year: 1150,
      approx_start_year: 800,
      date_range_en: "c. 800-1150AD (Colonisation & Coastal Valley Nucleation; Samoan Plainware Continuity)",
      epoch_id: 1,
      filename: "01_colonisation_founder_h1.png",
      geojson_filename: "01_colonisation_founder_h1.geojson",
      key: "colonisation_founder",
      name_de: "Polynesische Besiedlungsphase",
      name_en: "Polynesian Colonisation Phase",
      name_fr: "Phase de colonisation polynésienne",
      representative_year: 950
    },
    {
      approx_end_year: 1450,
      approx_start_year: 1150,
      date_range_en: "c. 1150-1450AD (Windward Alluvial Valley & Irrigated Lo'i Expansion)",
      epoch_id: 2,
      filename: "02_expansion_wetland_h2.png",
      geojson_filename: "02_expansion_wetland_h2.geojson",
      key: "expansion_wetland",
      name_de: "Expansions- und Nassfeldbauphase",
      name_en: "Expansion and Wetland Lo'i Phase",
      name_fr: "Expansion et cultures irriguées (Lo'i)",
      representative_year: 1300
    },
    {
      approx_end_year: 1650,
      approx_start_year: 1450,
      date_range_en: "c. 1450-1650AD (Leeward Dryland Field Systems: Kohala, Kona, Ka'u, Kahikinui)",
      epoch_id: 3,
      filename: "03_dryland_intensification_h3.png",
      geojson_filename: "03_dryland_intensification_h3.geojson",
      key: "dryland_intensification",
      name_de: "Intensivierung des Trockenfeldbaus",
      name_en: "Dryland Agricultural Intensification",
      name_fr: "Intensification des cultures sèches",
      representative_year: 1550
    },
    {
      approx_end_year: 1778,
      approx_start_year: 1650,
      date_range_en: "c. 1650-1778AD (Protohistoric Archaic States, Ahupua'a Equilibrium & Loko I'a Fishponds)",
      epoch_id: 4,
      filename: "04_protohistoric_archaic_state_h4.png",
      geojson_filename: "04_protohistoric_archaic_state_h4.geojson",
      key: "protohistoric_archaic_state",
      name_de: "Protohistorische Archaische Staaten",
      name_en: "Protohistoric Archaic State Apex",
      name_fr: "Apogée protohistorique des États archaïques",
      representative_year: 1750
    },
    {
      approx_end_year: 1853,
      approx_start_year: 1778,
      date_range_en: "1778-1853AD (Post-Contact Demographic Collapse, Missionary Censuses 1831-36 & Port Nucleation)",
      epoch_id: 5,
      filename: "05_kingdom_missionary_era_h5.png",
      geojson_filename: "05_kingdom_missionary_era_h5.geojson",
      key: "kingdom_missionary_era",
      name_de: "Missions- und Frühe Königreichszeit",
      name_en: "Missionary and Early Kingdom Era",
      name_fr: "Ère des missions et du royaume ancien",
      representative_year: 1835
    },
    {
      approx_end_year: 1898,
      approx_start_year: 1853,
      date_range_en: "1853-1898AD (Late Kingdom Censuses, Sugar Plantations & Pre-Annexation Rebound)",
      epoch_id: 6,
      filename: "06_late_kingdom_plantation_h6.png",
      geojson_filename: "06_late_kingdom_plantation_h6.geojson",
      key: "late_kingdom_plantation",
      name_de: "Späte Königreichs- und Plantagenzeit",
      name_en: "Late Kingdom and Plantation Transition",
      name_fr: "Royaume tardif et économie de plantation",
      representative_year: 1890
    }
  ]
}
