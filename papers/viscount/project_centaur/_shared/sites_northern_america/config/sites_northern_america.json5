{
  // Non-Stationary Matérn (nu = 3/2) Multi-Registry Archaeological Residual Kriging Configuration for Northern America (CENTAUR-II)
  // Spans USA (Lower 48 + Alaska + Bermuda), Canada, Greenland and Saint-Pierre-et-Miquelon (-10000 to 1600 AD),
  // with >= 250 km cross-frontier conditioning across Northern Mexico, Chukotka/Kamchatka (Russia) and Cuba/Bahamas.
  geojson_metadata_filename: "config/sites_northern_america_geojson_metadata.json",
  include_all_periods_geojson: true,
  kriging_metadata_filename: "config/kriging_diagnostics.json",
  output_geojson_subfolder: "geojson",
  output_kriged_rasters_subfolder: "1.kriged_rasters",
  output_population_rasters_subfolder: "2.population_rasters",
  png_compression_level: 6,

  kriging_config: {
    preserve_period_dynamics: true,
    hu_admixture_config: "histmap/3.data_transform/population_Substrata.viscount/centaur/config/centaur_hu_admixture.json5",
    residual_kriging_mode: "hu_hyde_residual",
    residual_kriging_module: "histmap/3.data_transform/population_Substrata.viscount/centaur/ViscountHUResidualKriging.js",
    all_hyde_years: [
      -10000, -9000, -8000, -7000, -6000, -5000, -4000, -3000, -2000, -1000,
      0, 100, 200, 300, 400, 500, 600, 700, 800, 900,
      1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700,
      1710, 1720, 1730, 1740, 1750, 1760, 1770, 1780, 1790,
      1800, 1810, 1820, 1830, 1840, 1850, 1860, 1870, 1880, 1890,
      1900, 1910, 1920, 1930, 1940, 1950, 1951, 1952, 1953, 1954, 1955,
      1956, 1957, 1958, 1959, 1960, 1961, 1962, 1963, 1964, 1965, 1966,
      1967, 1968, 1969, 1970, 1971, 1972, 1973, 1974, 1975, 1976, 1977,
      1978, 1979, 1980, 1981, 1982, 1983, 1984, 1985, 1986, 1987, 1988,
      1989, 1990, 1991, 1992, 1993, 1994, 1995, 1996, 1997, 1998, 1999,
      2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010,
      2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021,
      2022, 2023, 2024, 2025
    ],
    apply_arid_taphonomic_correction: true,
    apply_ice_sheet_mask: true,
    apply_urban_salvage_debias: true,
    bermuda_pixel: {
      area_km2: 53,
      col: 1382,
      row: 692
    },
    covariate_paths: {
      documented_site_pixels_json: "histmap/1.data_raw/population_regional/CENTAUR/_shared/sites_northern_america/config/documented_site_pixels.json",
      forest_asc: "histmap/1.data_raw/metadata_HYDE/general_files/forest_wwf_cr.asc",
      ghsl_urban_2020_raster: "histmap/1.data_raw/population_GHSL/urban_rasters/GHSL_2020.png",
      ghsl_urban_folder: "histmap/1.data_raw/population_GHSL/urban_rasters",
      ghsl_urban_pop_threshold: 35000,
      hyde_mcevedy_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_mcevedy",
      hyde_popc_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_scaled_to_global",
      hyde_raw_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters",
      hyde_uopp_raster: "histmap/2.data_cleaning/landuse_HYDE/rasters/uopp_2023AD.png",
      kk10_fallback_folder: "histmap/2.data_cleaning/population_KK10LUH2/rasters_KK10LUH2_2._global_scaling",
      lakes_geojson: "histmap/1.data_raw/population_regional/POLARIS/_shared/_gis_cache/ne_10m_lakes.geojson",
      landlake_asc: "histmap/1.data_raw/metadata_HYDE/general_files/landlake.asc",
      maxln_asc: "histmap/1.data_raw/metadata_HYDE/general_files/maxln_cr.asc",
      nelson_regions_png: "histmap/2.data_cleaning/population_KK10LUH2/config/nelson_regions.png",
      rivers_geojson: "histmap/1.data_raw/population_regional/POLARIS/_shared/_gis_cache/ne_10m_rivers_lake_centerlines.geojson",
      sub_iso_asc: "histmap/1.data_raw/metadata_HYDE/general_files/sub_iso_cr.asc",
      urban_fringe_uopp_threshold: 1.0,
      urban_mask_buffer_radius: 3,
      urban_mask_inpaint_radius: 6,
      urban_uopp_threshold: 3.8
    },
    dimensionless_lag_bins: [0.85, 1.45, 2.10, 2.95, 4.10, 5.60, 7.80, 10.80, 14.50],
    domain_mask_png: "histmap/1.data_raw/population_regional/CENTAUR/_shared/sites_northern_america/config/centaur_na_domain_mask.png",
    earth_radius_km: 6371,
    frontier_conditioning_max_dist_km: 300,
    grid_height: 2160,
    grid_width: 4320,
    target_domestic_catchments: 2350,

    // 10 Holocene horizons calibrated from multi-registry composite archaeological distributions
    chronological_horizons: [
      { active_periods: ["palaeoindian_early_archaic"], key: "palaeoindian_early_archaic_horizon", year: -8000 },
      { active_periods: ["middle_archaic"], key: "middle_archaic_horizon", year: -4500 },
      { active_periods: ["late_archaic"], key: "late_archaic_horizon", year: -2000 },
      { active_periods: ["early_woodland_formative"], key: "early_woodland_formative_horizon", year: -500 },
      { active_periods: ["middle_woodland_hopewell"], key: "middle_woodland_hopewell_horizon", year: 100 },
      { active_periods: ["late_woodland_dorset"], key: "late_woodland_dorset_horizon", year: 600 },
      { active_periods: ["early_mississippian_pueblo_ii"], key: "early_mississippian_pueblo_ii_horizon", year: 950 },
      { active_periods: ["middle_mississippian_pueblo_iii"], key: "middle_mississippian_pueblo_iii_horizon", year: 1200 },
      { active_periods: ["late_precontact_thule_oneota"], key: "late_precontact_thule_oneota_horizon", year: 1400 },
      { active_periods: ["protohistoric_contact_horizon"], key: "protohistoric_contact_horizon", year: 1550 }
    ]
  },

  periods: [
    {
      approx_end_year: -6000,
      approx_start_year: -13000,
      date_range_en: "c. 13000-6000BC (Clovis, Folsom, Dalton, Plano and Early Boreal Archaic)",
      epoch_id: 1,
      filename: "01_palaeoindian_early_archaic_h1.png",
      geojson_filename: "01_palaeoindian_early_archaic_h1.geojson",
      key: "palaeoindian_early_archaic",
      name_de: "Paläoindianisch bis Früharchaik",
      name_en: "Palaeoindian and Early Archaic",
      name_fr: "Paléoindien et Archaïque ancien",
      representative_year: -8000
    },
    {
      approx_end_year: -3000,
      approx_start_year: -6000,
      date_range_en: "c. 6000-3000BC (Middle Archaic, Hypsithermal refugia and Shield Archaic)",
      epoch_id: 2,
      filename: "02_middle_archaic_h2.png",
      geojson_filename: "02_middle_archaic_h2.geojson",
      key: "middle_archaic",
      name_de: "Mittelarchaik",
      name_en: "Middle Archaic",
      name_fr: "Archaïque moyen",
      representative_year: -4500
    },
    {
      approx_end_year: -1000,
      approx_start_year: -3000,
      date_range_en: "c. 3000-1000BC (Late Archaic, Poverty Point, Old Copper, Saqqaq and Independence I)",
      epoch_id: 3,
      filename: "03_late_archaic_h3.png",
      geojson_filename: "03_late_archaic_h3.geojson",
      key: "late_archaic",
      name_de: "Spätarchaik",
      name_en: "Late Archaic",
      name_fr: "Archaïque récent",
      representative_year: -2000
    },
    {
      approx_end_year: -200,
      approx_start_year: -1000,
      date_range_en: "c. 1000-200BC (Early Woodland, Adena, Basketmaker II, Saqqaq-Dorset and Early Dorset)",
      epoch_id: 4,
      filename: "04_early_woodland_formative_h4.png",
      geojson_filename: "04_early_woodland_formative_h4.geojson",
      key: "early_woodland_formative",
      name_de: "Frühe Waldland- und Formativzeit",
      name_en: "Early Woodland and Formative",
      name_fr: "Sylvicole ancien et Formatif",
      representative_year: -500
    },
    {
      approx_end_year: 400,
      approx_start_year: -200,
      date_range_en: "c. 200BC-400AD (Middle Woodland Hopewell, Swift Creek, Marpole and Middle Dorset)",
      epoch_id: 5,
      filename: "05_middle_woodland_hopewell_h5.png",
      geojson_filename: "05_middle_woodland_hopewell_h5.geojson",
      key: "middle_woodland_hopewell",
      name_de: "Mittlere Waldland-Hopewell-Zeit",
      name_en: "Middle Woodland Hopewell",
      name_fr: "Sylvicole moyen (Hopewell)",
      representative_year: 100
    },
    {
      approx_end_year: 800,
      approx_start_year: 400,
      date_range_en: "c. 400-800AD (Late Woodland, Coles Creek, Hohokam Colonial, Fremont and Late Dorset)",
      epoch_id: 6,
      filename: "06_late_woodland_dorset_h6.png",
      geojson_filename: "06_late_woodland_dorset_h6.geojson",
      key: "late_woodland_dorset",
      name_de: "Späte Waldland- und Dorset-Zeit",
      name_en: "Late Woodland and Dorset",
      name_fr: "Sylvicole supérieur et Dorsétien",
      representative_year: 600
    },
    {
      approx_end_year: 1100,
      approx_start_year: 800,
      date_range_en: "c. 800-1100AD (Emergent Mississippian, Chacoan Pueblo II, Norse Greenland and Early Thule)",
      epoch_id: 7,
      filename: "07_early_mississippian_pueblo_ii_h7.png",
      geojson_filename: "07_early_mississippian_pueblo_ii_h7.geojson",
      key: "early_mississippian_pueblo_ii",
      name_de: "Früh-Mississippi- und Pueblo-II-Zeit",
      name_en: "Early Mississippian and Pueblo II",
      name_fr: "Mississippien ancien et Pueblo II",
      representative_year: 950
    },
    {
      approx_end_year: 1300,
      approx_start_year: 1100,
      date_range_en: "c. 1100-1300AD (Middle Mississippian Cahokia apex, Pueblo III, Hohokam Classic, Norse and Thule)",
      epoch_id: 8,
      filename: "08_middle_mississippian_pueblo_iii_h8.png",
      geojson_filename: "08_middle_mississippian_pueblo_iii_h8.geojson",
      key: "middle_mississippian_pueblo_iii",
      name_de: "Mittel-Mississippi- und Pueblo-III-Zeit",
      name_en: "Middle Mississippian and Pueblo III",
      name_fr: "Mississippien moyen et Pueblo III",
      representative_year: 1200
    },
    {
      approx_end_year: 1500,
      approx_start_year: 1300,
      date_range_en: "c. 1300-1500AD (Late Pre-Contact, Iroquois/Haudenosaunee, Pueblo IV, Oneota and Thule Greenland)",
      epoch_id: 9,
      filename: "09_late_precontact_thule_oneota_h9.png",
      geojson_filename: "09_late_precontact_thule_oneota_h9.geojson",
      key: "late_precontact_thule_oneota",
      name_de: "Spätvorkoloniale Oneota- und Thule-Zeit",
