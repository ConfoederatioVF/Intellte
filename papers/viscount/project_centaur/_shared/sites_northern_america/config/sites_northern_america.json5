    {
      approx_end_year: 1650,
      approx_start_year: 1500,
      date_range_en: "c. 1500-1650AD (Protohistoric Contact Horizon: Haudenosaunee, Powhatan, Caddo, Pueblo V and Northwest Coast)",
      epoch_id: 10,
      filename: "10_protohistoric_contact_horizon_h10.png",
      geojson_filename: "10_protohistoric_contact_horizon_h10.geojson",
      key: "protohistoric_contact_horizon",
      name_de: "Protohistorischer Kontakthorizont",
