    mainland_continental: {
      pre_admin_end: 1600,
      colonial_start: 1600,
      contemporary_start: 1783,
    },
    canada_greenland: {
      pre_admin_end: 1600,
      colonial_start: 1600,
      contemporary_start: 1867,
    },
    hawaii_american_polynesia: {
      pre_admin_end: 1898,
      contemporary_start: 1898,
    },
  },
  geography_profile: {
    has_micro_islands: true,
    island_coastal_snap_px: 5,
    note: "Includes Hawaiian archipelago, American Samoa, Aleutians, Arctic Archipelago and Atlantic Barrier/Sea Islands.",
  },
  script_profile: {
    target_scripts: ["Latn"],
    allow_native_toponyms: true,
  },
