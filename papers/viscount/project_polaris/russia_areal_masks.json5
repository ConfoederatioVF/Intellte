    belarus_ukraine: {
      domain: [-10000, 1400],
      post_domain_blend_years: [1400],
      rasters_folder: "histmap/1.data_raw/population_regional/POLARIS/_shared/sites_belarus_ukraine/2.population_rasters"
    }
  },

  smoothing: {
    border_feather_radius_px: 3,
    interior_multiplier_blur_radius_px: 4,
    interior_multiplier_blur_passes: 2,
    temporal_log_Laplacian_weight: 0.15
  },

  // Priority 1: Macro-region synthesis across the entire Russian Federation (excl. Kaliningrad) + Crimea (100AD - 1900AD).
  // Specialist regional masks (Priority 2) override Priority 1 on their respective pixels; Priority 1 calibrates any remaining
  // macro-zone pixels (e.g. Northern Dvina/Arkhangelsk/Komi/Perm/Middle Volga forest belt) using residual macro-zone targets.
  macro_mask: {
    id: "migration_period",
    domain: [100, 1900],
    json5_path: "histmap/1.data_raw/population_regional/POLARIS/1.entire_country/1.migration_period/migration_period.json5",
    mask_path: "histmap/1.data_raw/population_regional/POLARIS/1.entire_country/1.migration_period/migration_period_areal_mask.png",
    priority: 1
  },

